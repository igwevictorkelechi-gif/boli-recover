# Only SESSION_SECRET is required. Everything else is optional.

# --- Required ---------------------------------------------------------------
# Signs ownership challenges and the 15-minute move session. Server-only.
# At least 32 random characters:  openssl rand -hex 32
# Rotating it just makes in-progress users prove ownership again.
SESSION_SECRET=

# --- Recommended for production ----------------------------------------------
# Full ERC-20 coverage on every chain. Without it the scan checks native coins
# plus a curated list of ~60 common tokens (src/lib/tokens.ts).
ALCHEMY_API_KEY=

# Keyed RPCs, tried before the built-in public ones. One URL or a
# comma-separated list per chain. Public RPCs rate-limit under real traffic.
# RPC_1=https://eth-mainnet.your-provider.com/KEY
# RPC_56=
# RPC_137=
# RPC_42161=
# RPC_10=
# RPC_8453=
# RPC_43114=

# --- Optional -----------------------------------------------------------------
# Supabase makes ownership challenges single-use across ALL server instances
# (otherwise: per instance, in memory). Apply supabase/migrations/* first.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Extra tokens to check per chain without an indexer (comma-separated).
# TOKENS_56=0x...,0x...
