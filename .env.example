# --- Supabase (server-side only; used by the ownership API routes) ---
# Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# SERVICE ROLE key. Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Ownership session (required for moving funds) ---
# Signs the short-lived token /api/verify issues and /api/transfer checks.
# Server-only. At least 32 random characters, e.g. `openssl rand -hex 32`.
# Rotating it signs everyone out of the move step (they just re-verify).
SESSION_SECRET=

# --- Token coverage (recommended) ---
# One Alchemy key enables full ERC-20 scanning on every supported chain.
# Without it, the scan falls back to the small curated list in src/lib/tokens.ts.
ALCHEMY_API_KEY=

# --- Optional: override public RPCs per chain if you hit rate limits ---
# The scan uses each chain's default public RPC when these are unset.
# RPC_1=https://eth-mainnet.your-provider.com/KEY
# RPC_56=https://bsc-mainnet.your-provider.com/KEY
# RPC_137=
# RPC_42161=
# RPC_10=
# RPC_8453=
# RPC_43114=

# --- Optional: WalletConnect (enables mobile wallets beyond injected) ---
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
